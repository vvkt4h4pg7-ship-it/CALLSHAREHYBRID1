<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>J7Bridge</string>
    <key>CFBundleDisplayName</key>
    <string>CALLSHARE</string>
    <key>CFBundleIdentifier</key>
    <string>com.ugur.callshare</string>
    <key>CFBundleName</key>
    <string>CALLSHARE</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSLocalNetworkUsageDescription</key>
    <string>CALLSHARE uses the local hotspot network to receive GSM audio from the paired J7.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>CALLSHARE uses Bluetooth Low Energy to communicate with the IKOS K7 gateway.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>CALLSHARE can use the microphone for optional uplink modes; Hybrid J7-native-mic mode does not transmit iPhone microphone audio.</string>
    <key>NSContactsUsageDescription</key>
    <string>CALLSHARE uses Contacts to display caller names and provide a dialable contact list.</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>bluetooth-central</string>
        <string>audio</string>
        <string>voip</string>
    </array>
    <key>UILaunchScreen</key>
    <dict/>
</dict>
</plist>
